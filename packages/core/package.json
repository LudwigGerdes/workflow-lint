{
  "name": "workflow-lint-core",
  "version": "0.1.0",
  "private": true,
  "description": "workflow-lint engine: workflow parsing with source map, lint graph, selectors, fixer, config and baseline",
  "keywords": [
    "n8n",
    "n8n-workflow",
    "linter",
    "static-analysis",
    "rules",
    "fixer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LudwigGerdes/workflow-lint.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/LudwigGerdes/workflow-lint#readme",
  "bugs": "https://github.com/LudwigGerdes/workflow-lint/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./rule-tester": {
      "types": "./dist/rule-tester.d.ts",
      "development": "./src/rule-tester.ts",
      "import": "./dist/rule-tester.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "workflow-lint-node-types": "workspace:*",
    "ignore": "^7.0.8",
    "json-source-map": "^0.6.1",
    "n8n-workflow": "2.38.1",
    "nanoid": "^5.0.7",
    "picomatch": "^4.0.2",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/picomatch": "^3.0.1"
  }
}
